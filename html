                      <!-- 框内右侧小圆圈叉叉清空按钮 -->
                      <button id="screen-btn-quick-clear" class="w-4 h-4 rounded-full bg-zinc-800 hover:bg-zinc-700 text-zinc-400 hover:text-white flex items-center justify-center text-[10px] ml-1 shrink-0 transition" title="清空内容">
                        ✕
                      </button>
