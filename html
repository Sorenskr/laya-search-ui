                  <div id="screen-icon-5g" class="flex flex-col items-center justify-center scale-90 leading-tight">
                    <div class="flex items-center gap-0.5">
                      <span class="text-[7px] font-bold text-zinc-300">5G</span>
                      <div class="flex items-end gap-[1px] h-2">
                        <span class="w-[1.5px] h-1 bg-white"></span>
