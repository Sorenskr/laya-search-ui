                    <path d="M50,15 C30.67,15 15,30.67 15,50 C15,69.33 30.67,85 50,85 C69.33,85 85,69.33 85,50 C85,38 78,28 68,22 C67,21.5 65.5,22.5 66,23.8 C71.5,37.5 62.5,52 48.5,53.5 C36.2,54.8 26.5,44.5 28,32.2 C29.2,21.8 38.5,15 50,15 Z" />
