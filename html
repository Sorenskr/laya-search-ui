                  <!-- 发光渐变胶囊外壳 -->
                  <div id="glow-capsule-wrapper" class="glow-purple-gold flex-1 p-[2.5px] rounded-full transition-all duration-300">
                    
                    <!-- 胶囊内黑底与文字内容区 -->
                    <div class="bg-[#0b0c10] rounded-full px-3.5 py-2.5 flex items-center justify-between text-white shadow-inner">
                      
                      <!-- 搜索图标与可输入文字区 -->
                      <div class="flex items-center space-x-2 flex-1 overflow-hidden">
                        <!-- Q / 放大镜搜索图标 (完全还原原图) -->
                        <div class="text-zinc-200 flex items-center justify-center shrink-0">
                          <svg class="w-4 h-4 stroke-[2.8]" viewBox="0 0 24 24" fill="none" stroke="currentColor">
