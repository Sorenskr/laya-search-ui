  <!-- 手机端图片长按保存弹窗 -->
  <div id="export-preview-modal" class="fixed inset-0 z-50 bg-black/85 backdrop-blur-md flex items-center justify-center p-4 hidden opacity-0 transition-opacity duration-200">
    <div class="bg-zinc-900 border border-zinc-800 rounded-2xl max-w-sm w-full p-4 flex flex-col items-center text-center shadow-2xl relative">
      <button id="btn-close-modal-x" class="absolute top-3 right-3 text-zinc-400 hover:text-white p-1 rounded-lg bg-zinc-800/80">
        <i data-lucide="x" class="w-4 h-4"></i>
      </button>

      <div class="w-10 h-10 rounded-full bg-purple-500/20 text-purple-400 flex items-center justify-center mb-2">
        <i data-lucide="check" class="w-5 h-5"></i>
      </div>
      <h3 class="text-base font-bold text-white">截图渲染完成</h3>
      <p class="text-xs text-zinc-400 mt-1 mb-3">长按下方图片可直接存储到手机相册</p>

      <div class="w-full max-h-[62vh] overflow-auto rounded-xl border border-zinc-800 bg-zinc-950 p-2 flex items-center justify-center">
        <img id="modal-img-element" src="" alt="截图预览" class="max-w-full h-auto rounded-lg shadow-md">
      </div>

      <div class="w-full flex gap-2 mt-4">
        <a id="modal-btn-download-link" href="#" download="glow-search-vertical.png" class="flex-1 py-2.5 rounded-xl bg-purple-600 hover:bg-purple-700 text-white font-semibold text-xs flex items-center justify-center gap-1.5 transition">
          <i data-lucide="download" class="w-3.5 h-3.5"></i> 直接下载
        </a>
        <button id="btn-close-modal-bottom" class="px-4 py-2.5 rounded-xl bg-zinc-800 hover:bg-zinc-700 text-zinc-300 text-xs font-medium transition">
          关闭
        </button>
      </div>
    </div>
  </div>

  <!-- 轻量通知 Toast 容器 -->
  <div id="app-toast-shelf" class="fixed bottom-6 left-1/2 -translate-x-1/2 z-50 pointer-events-none flex flex-col items-center gap-2"></div>

  <script>
    // 初始化矢量图标
    lucide.createIcons();

    // DOM 获取
    const inputQueryText = document.getElementById('input-query-text');
    const screenDisplayQuery = document.getElementById('screen-display-query');
    const btnClearQuery = document.getElementById('btn-clear-query');
    const screenBtnQuickClear = document.getElementById('screen-btn-quick-clear');

    const inputCancelBtnText = document.getElementById('input-cancel-btn-text');
    const screenDisplayCancel = document.getElementById('screen-display-cancel');
    const inputStatusHintText = document.getElementById('input-status-hint-text');
    const screenDisplayHint = document.getElementById('screen-display-hint');

    const inputBarTime = document.getElementById('input-bar-time');
    const screenTimeText = document.getElementById('screen-time-text');
    const btnSyncTime = document.getElementById('btn-sync-time');

    const inputBarBattery = document.getElementById('input-bar-battery');
    const labelBattery = document.getElementById('label-battery');
    const screenBatteryBar = document.getElementById('screen-battery-bar');
    const screenBatteryNum = document.getElementById('screen-battery-num');

    const toggleOptVpn = document.getElementById('toggle-opt-vpn');
    const screenIconVpn = document.getElementById('screen-icon-vpn');
    const toggleOpt5g = document.getElementById('toggle-opt-5g');
    const screenIcon5g = document.getElementById('screen-icon-5g');
    const toggleOptAlarm = document.getElementById('toggle-opt-alarm');
    const screenIconAlarm = document.getElementById('screen-icon-alarm');

    const toggleOptCursor = document.getElementById('toggle-opt-cursor');
    const screenCyanCursor = document.getElementById('screen-cyan-cursor');
    const toggleOptWatermark = document.getElementById('toggle-opt-watermark');
    const screenWatermarkWrap = document.getElementById('screen-watermark-wrap');

    const glowCapsuleWrapper = document.getElementById('glow-capsule-wrapper');
    const glowOptBtns = document.querySelectorAll('.glow-opt-btn');
    const quickChipBtns = document.querySelectorAll('.quick-chip-btn');
    const btnQuickReset = document.getElementById('btn-quick-reset');

    const modePureScreen = document.getElementById('mode-pure-screen');
    const modePhoneFrame = document.getElementById('mode-phone-frame');
    const captureFrameNode = document.getElementById('capture-frame-node');
    const phoneChassis = document.getElementById('phone-chassis');
    const speakerSlit = document.getElementById('speaker-slit');
    const screenDisplayArea = document.getElementById('screen-display-area');

    const btnExportPng = document.getElementById('btn-export-png');
    const btnHeaderExport = document.getElementById('btn-header-export');
    const btnCopyImg = document.getElementById('btn-copy-img');
    const btnMobilePreview = document.getElementById('btn-mobile-preview');

    const exportPreviewModal = document.getElementById('export-preview-modal');
    const modalImgElement = document.getElementById('modal-img-element');
    const modalBtnDownloadLink = document.getElementById('modal-btn-download-link');
    const btnCloseModalX = document.getElementById('btn-close-modal-x');
    const btnCloseModalBottom = document.getElementById('btn-close-modal-bottom');

    let currentMode = 'pure'; // 'pure' 纯净屏幕直出模式 | 'frame' 真机边框模式
    let currentGlowClass = 'glow-purple-gold';

    // 优雅通知提示
    function notify(msg, type = 'info') {
      const toast = document.createElement('div');
      toast.className = `px-4 py-2.5 rounded-xl text-xs font-semibold text-white shadow-2xl transition-all duration-300 transform translate-y-3 opacity-0 flex items-center gap-2 ${
        type === 'error' ? 'bg-rose-950 border border-rose-500 text-rose-200' : 'bg-zinc-800 border border-purple-500/50 text-purple-200'
      }`;
      toast.innerHTML = `<span>✨</span><span>${msg}</span>`;
      
      const shelf = document.getElementById('app-toast-shelf');
      shelf.appendChild(toast);

      requestAnimationFrame(() => {
        toast.classList.remove('translate-y-3', 'opacity-0');
      });

      setTimeout(() => {
        toast.classList.add('opacity-0', 'translate-y-2');
        setTimeout(() => toast.remove(), 260);
      }, 2300);
    }

    // 双向同步搜索框文本
    inputQueryText.addEventListener('input', (e) => {
      screenDisplayQuery.textContent = e.target.value;
    });
    screenDisplayQuery.addEventListener('input', (e) => {
      inputQueryText.value = e.target.textContent.trim();
    });

    // 清空操作
    function executeClearQuery() {
      inputQueryText.value = '';
      screenDisplayQuery.textContent = '';
      notify('已清空搜索内容');
    }
    btnClearQuery.addEventListener('click', executeClearQuery);
    screenBtnQuickClear.addEventListener('click', executeClearQuery);

    // 取消按钮文本双向同步
    inputCancelBtnText.addEventListener('input', (e) => {
      screenDisplayCancel.textContent = e.target.value;
      screenDisplayCancel.style.display = e.target.value ? 'block' : 'none';
    });
    screenDisplayCancel.addEventListener('input', (e) => {
      inputCancelBtnText.value = e.target.textContent;
    });

    // 状态提示文本双向同步
    inputStatusHintText.addEventListener('input', (e) => {
      screenDisplayHint.textContent = e.target.value;
    });
    screenDisplayHint.addEventListener('input', (e) => {
      inputStatusHintText.value = e.target.textContent;
    });

    // 状态栏时间同步
    inputBarTime.addEventListener('input', (e) => {
      screenTimeText.textContent = e.target.value;
    });
    screenTimeText.addEventListener('input', (e) => {
      inputBarTime.value = e.target.textContent;
    });

    // 同步真实当前时间
    btnSyncTime.addEventListener('click', () => {
      const now = new Date();
      const hh = String(now.getHours()).padStart(2, '0');
      const mm = String(now.getMinutes()).padStart(2, '0');
      const timeStr = `${hh}:${mm}`;
      inputBarTime.value = timeStr;
      screenTimeText.textContent = timeStr;
      notify(`已同步时间为 ${timeStr}`);
    });

    // 电量滑块
    inputBarBattery.addEventListener('input', (e) => {
      const val = e.target.value;
      labelBattery.textContent = `${val}%`;
      screenBatteryNum.textContent = val;
      screenBatteryBar.style.width = `${val}%`;
      if (val <= 20) {
        screenBatteryBar.classList.remove('bg-zinc-300');
        screenBatteryBar.classList.add('bg-rose-500');
      } else {
        screenBatteryBar.classList.remove('bg-rose-500');
        screenBatteryBar.classList.add('bg-zinc-300');
      }
    });

    // 状态栏小图标开关
    toggleOptVpn.addEventListener('change', (e) => {
      screenIconVpn.style.display = e.target.checked ? 'inline-block' : 'none';
    });
    toggleOpt5g.addEventListener('change', (e) => {
      screenIcon5g.style.display = e.target.checked ? 'flex' : 'none';
    });
    toggleOptAlarm.addEventListener('change', (e) => {
      screenIconAlarm.style.display = e.target.checked ? 'inline-block' : 'none';
    });

    // 光标与水印虚影开关
    toggleOptCursor.addEventListener('change', (e) => {
      screenCyanCursor.style.display = e.target.checked ? 'inline-block' : 'none';
    });
    toggleOptWatermark.addEventListener('change', (e) => {
      screenWatermarkWrap.style.display = e.target.checked ? 'block' : 'none';
    });

    // 快捷文案芯片点击
    quickChipBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        const text = btn.getAttribute('data-text');
        const res = btn.getAttribute('data-res');
        inputQueryText.value = text;
        screenDisplayQuery.textContent = text;
        if (res) {
          inputStatusHintText.value = res;
          screenDisplayHint.textContent = res;
        }
        notify(`已应用文案：“${text}”`);
      });
    });

    // 霓虹发光色系切换
    const glowClassList = ['glow-purple-gold', 'glow-cyan-pink', 'glow-aurora-green', 'glow-sunset-gold', 'glow-rainbow-ai'];
    glowOptBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        const selectedGlow = btn.getAttribute('data-glow');
        currentGlowClass = selectedGlow;

        glowOptBtns.forEach(b => {
          b.classList.remove('border-purple-500', 'border-2', 'bg-zinc-800');
          b.classList.add('border-zinc-700', 'border', 'bg-zinc-800/40');
        });
        btn.classList.add('border-purple-500', 'border-2', 'bg-zinc-800');
        btn.classList.remove('border-zinc-700', 'border', 'bg-zinc-800/40');

        glowClassList.forEach(cls => glowCapsuleWrapper.classList.remove(cls));
        glowCapsuleWrapper.classList.add(selectedGlow);
      });
    });

    // 截图模式切换逻辑：纯净直出截屏 vs 真机模型外壳
    function applyScreenshotMode(mode) {
      currentMode = mode;
      if (mode === 'pure') {
        // 纯净屏幕直出模式：隐藏外机身、外边框与听筒，直接截取 9:19.5 的真实内屏
        modePureScreen.classList.add('border-purple-500', 'border-2', 'bg-zinc-800/90');
        modePureScreen.classList.remove('border-zinc-700/60', 'border', 'bg-zinc-800/40');
        modePhoneFrame.classList.remove('border-purple-500', 'border-2', 'bg-zinc-800/90');
        modePhoneFrame.classList.add('border-zinc-700/60', 'border', 'bg-zinc-800/40');

        phoneChassis.className = 'w-[360px] sm:w-[380px] bg-transparent p-0 border-0 rounded-none relative select-none transition-all duration-300';
        speakerSlit.style.display = 'none';
        screenDisplayArea.className = 'w-full bg-[#000000] rounded-none overflow-hidden relative min-h-[660px] flex flex-col justify-between';
        captureFrameNode.className = 'transition-all duration-300 flex items-center justify-center bg-black';
        notify('已切换为：纯净屏幕直出截屏模式');
      } else {
        // 真机质感模型模式
        modePhoneFrame.classList.add('border-purple-500', 'border-2', 'bg-zinc-800/90');
        modePhoneFrame.classList.remove('border-zinc-700/60', 'border', 'bg-zinc-800/40');
        modePureScreen.classList.remove('border-purple-500', 'border-2', 'bg-zinc-800/90');
        modePureScreen.classList.add('border-zinc-700/60', 'border', 'bg-zinc-800/40');

        phoneChassis.className = 'w-[360px] sm:w-[380px] bg-black rounded-[42px] phone-realistic-frame p-2.5 border-[4px] border-[#22242a] relative select-none transition-all duration-300 overflow-hidden';
        speakerSlit.style.display = 'block';
        screenDisplayArea.className = 'w-full bg-[#000000] rounded-[34px] overflow-hidden relative min-h-[660px] flex flex-col justify-between';
        captureFrameNode.className = 'transition-all duration-300 flex items-center justify-center bg-transparent';
        notify('已切换为：真机模型质感模式');
      }
    }

    modePureScreen.addEventListener('click', () => applyScreenshotMode('pure'));
    modePhoneFrame.addEventListener('click', () => applyScreenshotMode('frame'));
    // 默认启用纯净直出屏幕截屏模式，更符合“截图”的需求
    applyScreenshotMode('pure');

    // 重置按钮
    btnQuickReset.addEventListener('click', () => {
      inputQueryText.value = '1896';
      screenDisplayQuery.textContent = '1896';
      inputCancelBtnText.value = '取消';
      screenDisplayCancel.textContent = '取消';
      screenDisplayCancel.style.display = 'block';
      inputStatusHintText.value = '无结果';
      screenDisplayHint.textContent = '无结果';
      inputBarTime.value = '16:01';
      screenTimeText.textContent = '16:01';
      inputBarBattery.value = 23;
      labelBattery.textContent = '23%';
      screenBatteryNum.textContent = '23';
      screenBatteryBar.style.width = '23%';
      document.querySelector('[data-glow="glow-purple-gold"]').click();
      notify('已恢复为原图默认设定');
    });

    // 高清图片截取函数
    async function captureRenderedCanvas() {
      // 截图时确保幽蓝光标处于完全显示状态
      if (toggleOptCursor.checked) {
        screenCyanCursor.classList.remove('animate-cursor-blink');
        screenCyanCursor.style.opacity = '1';
      }

      // 决定截图截取的 DOM 节点
      const targetElement = currentMode === 'pure' ? screenDisplayArea : captureFrameNode;

      const options = {
        backgroundColor: currentMode === 'pure' ? '#000000' : null,
        scale: 2.5, // 2.5倍无损Retina采样率
        useCORS: true,
        allowTaint: true,
        logging: false
      };

      try {
        const canvas = await html2canvas(targetElement, options);
        if (toggleOptCursor.checked) {
          screenCyanCursor.classList.add('animate-cursor-blink');
        }
        return canvas;
      } catch (err) {
        console.error('Canvas capture failed:', err);
        notify('截图生成异常，请重试', 'error');
        if (toggleOptCursor.checked) {
          screenCyanCursor.classList.add('animate-cursor-blink');
        }
        return null;
      }
    }

    // 1. 下载 PNG
    async function triggerExportPng() {
      notify('正在生成高清原画截图中...');
      btnExportPng.disabled = true;
      btnExportPng.classList.add('opacity-70');

      const canvas = await captureRenderedCanvas();
      if (canvas) {
        const dataUrl = canvas.toDataURL('image/png');
        const link = document.createElement('a');
        link.download = `glow-search-${inputQueryText.value.trim() || 'screenshot'}.png`;
        link.href = dataUrl;
        document.body.appendChild(link);
        link.click();
        document.body.removeChild(link);
        notify('高清截图已成功下载！');
      }

      btnExportPng.disabled = false;
      btnExportPng.classList.remove('opacity-70');
    }
    btnExportPng.addEventListener('click', triggerExportPng);
    btnHeaderExport.addEventListener('click', triggerExportPng);

    // 2. 复制到剪贴板
    btnCopyImg.addEventListener('click', async () => {
      notify('正在转换图片数据...');
      const canvas = await captureRenderedCanvas();
      if (!canvas) return;

      if (navigator.clipboard && window.ClipboardItem) {
        try {
          canvas.toBlob(async (blob) => {
            if (!blob) {
              notify('图片生成错误', 'error');
              return;
            }
            await navigator.clipboard.write([
              new ClipboardItem({ 'image/png': blob })
            ]);
            notify('已成功复制图片到剪贴板！可以直接粘贴了');
          }, 'image/png');
        } catch (e) {
          openMobilePreviewModal(canvas);
          notify('已弹出图片，可长按保存或复制');
        }
      } else {
        openMobilePreviewModal(canvas);
        notify('已弹出图片，可长按保存');
      }
    });

    // 3. 手机端长按保存弹窗
    function openMobilePreviewModal(canvas) {
      const dataUrl = canvas.toDataURL('image/png');
      modalImgElement.src = dataUrl;
      modalBtnDownloadLink.href = dataUrl;
      modalBtnDownloadLink.download = `glow-search-${inputQueryText.value.trim() || 'shot'}.png`;

      exportPreviewModal.classList.remove('hidden');
      requestAnimationFrame(() => {
        exportPreviewModal.classList.remove('opacity-0');
      });
    }

    btnMobilePreview.addEventListener('click', async () => {
      notify('正在生成预览弹窗...');
      const canvas = await captureRenderedCanvas();
      if (canvas) {
        openMobilePreviewModal(canvas);
      }
    });

    function closePreviewModal() {
      exportPreviewModal.classList.add('opacity-0');
      setTimeout(() => {
        exportPreviewModal.classList.add('hidden');
      }, 200);
    }
    btnCloseModalX.addEventListener('click', closePreviewModal);
    btnCloseModalBottom.addEventListener('click', closePreviewModal);
    exportPreviewModal.addEventListener('click', (e) => {
      if (e.target === exportPreviewModal) closePreviewModal();
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !exportPreviewModal.classList.contains('hidden')) {
        closePreviewModal();
      }
    });
  </script>
</body>
</html>
