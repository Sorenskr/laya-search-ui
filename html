                      </div>
                    </div>
                    <div class="flex items-center gap-0.5 -mt-0.5">
                      <span class="text-[7px] font-bold text-zinc-400">5G</span>
                      <div class="flex items-end gap-[1px] h-1.5">
                        <span class="w-[1.5px] h-0.5 bg-zinc-300"></span>
                        <span class="w-[1.5px] h-1 bg-zinc-300"></span>
                        <span class="w-[1.5px] h-1.5 bg-zinc-300"></span>
                      </div>
                    </div>
                  </div>

                  <!-- Wi-Fi 满格 -->
                  <svg class="w-3.5 h-3.5 text-zinc-100 inline-block" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M12 4C7.31 4 3.07 5.9 0 8.98L12 21 24 8.98A16.88 16.88 0 0 0 12 4zm0 3.5c3.78 0 7.22 1.48 9.77 3.92L12 19.34 2.23 11.42A13.39 13.39 0 0 1 12 7.5z"/>
                  </svg>

                  <!-- 原生电量胶囊 (内置 23 数字) -->
                  <div class="relative w-6 h-3.5 rounded-[4px] border border-zinc-400/90 p-[1px] flex items-center justify-center">
                    <div id="screen-battery-bar" class="absolute left-[1px] top-[1px] bottom-[1px] bg-zinc-300 rounded-[2px]" style="width: 23%;"></div>
