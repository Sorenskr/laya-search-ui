                          <!-- 幽蓝输入光标 (原图蓝色竖光标) -->
                          <span id="screen-cyan-cursor" class="w-[2px] h-4 bg-[#38bdf8] ml-0.5 rounded-full animate-cursor-blink inline-block shadow-[0_0_8px_#38bdf8]"></span>
