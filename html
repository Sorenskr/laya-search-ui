                  <!-- 搜索框外侧“取消”按钮 (原图特征) -->
                  <button id="screen-display-cancel" class="text-xs text-zinc-300 hover:text-white font-medium shrink-0 px-1 py-1 outline-none" contenteditable="true" spellcheck="false">
