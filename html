<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>发光搜索框截图生成器 - 标准竖屏高保真版</title>
  <!-- Tailwind CSS -->
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- html2canvas 2.5x 高清截图引擎 -->
  <script src="https://cdn.jsdelivr.net/npm/html2canvas@1.4.1/dist/html2canvas.min.js"></script>
  <!-- Lucide 矢量图标库 -->
  <script src="https://unpkg.com/lucide@latest"></script>
  
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500;700&display=swap');

    * {
      font-family: 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", sans-serif;
    }

    /* 1. 原图复刻：粉紫渐变暖金流光辉光 */
    .glow-purple-gold {
      background: linear-gradient(90deg, #db2777 0%, #c026d3 30%, #a855f7 65%, #f59e0b 98%);
      box-shadow: 
        0 0 16px rgba(219, 39, 119, 0.55),
        0 0 32px rgba(168, 85, 247, 0.4),
        0 0 50px rgba(245, 158, 11, 0.28);
    }

    /* 2. 赛博霓虹蓝粉 */
    .glow-cyan-pink {
      background: linear-gradient(90deg, #06b6d4 0%, #3b82f6 50%, #ec4899 100%);
      box-shadow: 
        0 0 18px rgba(6, 182, 212, 0.55),
        0 0 36px rgba(236, 72, 153, 0.4);
    }

    /* 3. 极光冰葱绿 */
    .glow-aurora-green {
      background: linear-gradient(90deg, #10b981 0%, #06b6d4 50%, #6366f1 100%);
      box-shadow: 
        0 0 18px rgba(16, 185, 129, 0.55),
        0 0 36px rgba(6, 182, 212, 0.35);
    }

    /* 4. 暗夜落日鎏金 */
    .glow-sunset-gold {
      background: linear-gradient(90deg, #e11d48 0%, #ea580c 50%, #facc15 100%);
      box-shadow: 
        0 0 18px rgba(225, 29, 72, 0.55),
        0 0 38px rgba(250, 204, 21, 0.35);
    }

    /* 5. 幻彩AI流光 */
    .glow-rainbow-ai {
      background: linear-gradient(90deg, #ec4899 0%, #8b5cf6 25%, #3b82f6 50%, #10b981 75%, #f59e0b 100%);
      box-shadow: 
        0 0 20px rgba(139, 92, 246, 0.55),
        0 0 40px rgba(236, 72, 153, 0.35);
    }

    /* 幽蓝输入光标闪烁动画 */
    @keyframes typing-cursor-blink {
      0%, 100% { opacity: 1; }
      50% { opacity: 0; }
    }
    .animate-cursor-blink {
      animation: typing-cursor-blink 1s cubic-bezier(0.4, 0, 0.6, 1) infinite;
    }

    /* 真实手机外壳阴影与反光 */
    .phone-realistic-frame {
      box-shadow: 
        0 25px 60px -15px rgba(0, 0, 0, 0.75),
        0 12px 28px -8px rgba(0, 0, 0, 0.5),
        0 0 0 1px rgba(255, 255, 255, 0.12),
        inset 0 1px 2px rgba(255, 255, 255, 0.15);
    }

    /* 屏幕玻璃微反光 */
    .screen-glass-glare {
      background: linear-gradient(135deg, rgba(255, 255, 255, 0.05) 0%, rgba(255, 255, 255, 0.01) 40%, transparent 60%);
    }

    /* 纯黑沉浸滚动条 */
    ::-webkit-scrollbar {
      width: 6px;
      height: 6px;
    }
    ::-webkit-scrollbar-track {
      background: #09090b;
    }
    ::-webkit-scrollbar-thumb {
      background: #27272a;
      border-radius: 9999px;
    }
    ::-webkit-scrollbar-thumb:hover {
      background: #3f3f46;
    }
  </style>
</head>

<body class="bg-[#09090b] text-zinc-100 min-h-screen flex flex-col antialiased selection:bg-purple-600 selection:text-white">

  <!-- 顶部导航栏 -->
  <header class="border-b border-zinc-800/80 bg-zinc-900/90 backdrop-blur sticky top-0 z-40 px-4 sm:px-6 py-3 flex items-center justify-between">
    <div class="flex items-center space-x-3">
      <div class="w-8 h-8 rounded-xl bg-gradient-to-tr from-pink-500 via-purple-600 to-amber-400 flex items-center justify-center shadow-lg shadow-purple-500/20">
        <i data-lucide="sparkles" class="w-4 h-4 text-white"></i>
      </div>
      <div>
        <h1 class="text-sm sm:text-base font-bold tracking-tight text-white flex items-center gap-2">
          发光搜索框截图生成器
          <span class="text-[11px] px-2 py-0.5 rounded-full bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 font-medium">
            正向竖屏 9:19.5
          </span>
        </h1>
        <p class="text-xs text-zinc-400 hidden sm:block">标准垂直朝向 · 自定义输入文字 · 一键导出原图画质</p>
      </div>
    </div>

    <!-- 顶部动作按钮 -->
    <div class="flex items-center gap-2.5">
      <button id="btn-quick-reset" class="px-3 py-1.5 rounded-lg text-xs font-medium text-zinc-300 hover:text-white bg-zinc-800 hover:bg-zinc-700 transition flex items-center gap-1.5">
        <i data-lucide="rotate-ccw" class="w-3.5 h-3.5"></i>
        <span class="hidden sm:inline">重置为原图文字</span>
      </button>
      <button id="btn-header-export" class="px-3.5 py-1.5 rounded-lg text-xs font-semibold text-white bg-gradient-to-r from-pink-500 via-purple-600 to-indigo-600 hover:from-pink-600 hover:to-indigo-700 shadow-lg shadow-purple-600/30 transition flex items-center gap-1.5 active:scale-95">
        <i data-lucide="download" class="w-3.5 h-3.5"></i>
        <span>下载高清截图</span>
      </button>
    </div>
  </header>

  <main class="flex-1 max-w-7xl w-full mx-auto p-3 sm:p-5 lg:p-6 grid grid-cols-1 lg:grid-cols-12 gap-6 items-start">

    <!-- 左侧控制面板 (5列) -->
    <div class="lg:col-span-5 flex flex-col space-y-4 bg-zinc-900/90 border border-zinc-800/80 rounded-2xl p-4 sm:p-5 shadow-2xl backdrop-blur order-2 lg:order-1">
      
      <!-- 截图模式选择 -->
      <div>
        <label class="text-xs font-semibold text-zinc-300 uppercase tracking-wider block mb-2 flex items-center justify-between">
          <span><i data-lucide="layout" class="w-3.5 h-3.5 inline mr-1 text-purple-400"></i> 输出截图模式</span>
          <span class="text-[11px] text-zinc-500 font-normal">生成你要的截图类型</span>
        </label>
        <div class="grid grid-cols-2 gap-2">
          <button id="mode-pure-screen" class="screenshot-mode-btn active p-2.5 rounded-xl border-2 border-purple-500 bg-zinc-800/90 text-left transition flex items-center gap-2.5">
            <div class="w-8 h-8 rounded-lg bg-purple-500/20 text-purple-400 flex items-center justify-center shrink-0">
              <i data-lucide="crop" class="w-4 h-4"></i>
            </div>
            <div>
              <div class="text-xs font-semibold text-white">纯净手机屏幕直出</div>
              <div class="text-[10px] text-zinc-400">如同真机按电源键截屏</div>
            </div>
          </button>

          <button id="mode-phone-frame" class="screenshot-mode-btn p-2.5 rounded-xl border border-zinc-700/60 bg-zinc-800/40 text-left transition flex items-center gap-2.5">
            <div class="w-8 h-8 rounded-lg bg-zinc-800 text-zinc-400 flex items-center justify-center shrink-0">
              <i data-lucide="smartphone" class="w-4 h-4"></i>
            </div>
            <div>
              <div class="text-xs font-semibold text-zinc-300">真机外壳质感模组</div>
              <div class="text-[10px] text-zinc-400">带金属机身边框与微缝</div>
            </div>
          </button>
        </div>
      </div>

      <!-- 搜索框内容设置 -->
      <div class="space-y-3 pt-3 border-t border-zinc-800">
        <label class="text-xs font-semibold text-zinc-300 uppercase tracking-wider block flex items-center justify-between">
          <span><i data-lucide="type" class="w-3.5 h-3.5 inline mr-1 text-purple-400"></i> 搜索框内容自定义</span>
          <span class="text-[11px] text-zinc-500 font-normal">也可直接点击右侧屏幕打字</span>
        </label>

        <div>
          <label class="text-xs text-zinc-400 block mb-1">框内搜索文字</label>
          <div class="relative">
            <input type="text" id="input-query-text" value="1896" placeholder="输入任何文字、暗号、表白语..." 
              class="w-full bg-zinc-950 border border-zinc-700 focus:border-purple-500 rounded-xl px-3.5 py-2.5 text-sm text-white placeholder-zinc-500 outline-none transition font-medium">
            <button id="btn-clear-query" class="absolute right-2.5 top-1/2 -translate-y-1/2 text-zinc-500 hover:text-zinc-300 text-xs px-2 py-1 bg-zinc-800/60 rounded-md">
              清空
            </button>
          </div>
        </div>

        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="text-xs text-zinc-400 block mb-1">右侧按钮文字</label>
            <input type="text" id="input-cancel-btn-text" value="取消" placeholder="取消" 
              class="w-full bg-zinc-950 border border-zinc-700 focus:border-purple-500 rounded-xl px-3 py-2 text-sm text-white outline-none transition">
          </div>
          <div>
            <label class="text-xs text-zinc-400 block mb-1">下方状态提示</label>
            <input type="text" id="input-status-hint-text" value="无结果" placeholder="无结果 / 已找到唯一答案" 
              class="w-full bg-zinc-950 border border-zinc-700 focus:border-purple-500 rounded-xl px-3 py-2 text-sm text-white outline-none transition">
          </div>
        </div>

        <!-- 常用快捷灵感填词 -->
        <div>
          <div class="text-[11px] text-zinc-400 mb-1.5 flex items-center justify-between">
            <span>快捷文案填入：</span>
          </div>
          <div class="flex flex-wrap gap-1.5">
            <button class="quick-chip-btn text-xs px-2.5 py-1 rounded-lg bg-zinc-800 hover:bg-zinc-700 text-zinc-300 hover:text-white transition" data-text="1896" data-res="无结果">1896 (原图)</button>
            <button class="quick-chip-btn text-xs px-2.5 py-1 rounded-lg bg-zinc-800 hover:bg-zinc-700 text-zinc-300 hover:text-white transition" data-text="宇宙中唯一的你" data-res="❤️ 匹配成功 100%">宇宙中唯一的你</button>
            <button class="quick-chip-btn text-xs px-2.5 py-1 rounded-lg bg-zinc-800 hover:bg-zinc-700 text-zinc-300 hover:text-white transition" data-text="发财 & 暴富" data-res="好运正在极速送达中...">发财 & 暴富</button>
            <button class="quick-chip-btn text-xs px-2.5 py-1 rounded-lg bg-zinc-800 hover:bg-zinc-700 text-zinc-300 hover:text-white transition" data-text="今日下班倒计时" data-res="打卡机已就绪">今日下班倒计时</button>
            <button class="quick-chip-btn text-xs px-2.5 py-1 rounded-lg bg-zinc-800 hover:bg-zinc-700 text-zinc-300 hover:text-white transition" data-text="上岸顺利" data-res="录取通知书派发中">上岸顺利</button>
          </div>
        </div>
      </div>

      <!-- 发光霓虹光晕色系 -->
      <div class="space-y-2 pt-3 border-t border-zinc-800">
        <label class="text-xs font-semibold text-zinc-300 uppercase tracking-wider block">
          <i data-lucide="palette" class="w-3.5 h-3.5 inline mr-1 text-purple-400"></i> 发光流光色彩
        </label>
        <div class="grid grid-cols-5 gap-2" id="glow-theme-selector">
          <button data-glow="glow-purple-gold" class="glow-opt-btn active p-2 rounded-xl border-2 border-purple-500 bg-zinc-800 flex flex-col items-center gap-1.5 transition">
            <span class="w-5 h-5 rounded-full bg-gradient-to-r from-pink-500 via-purple-500 to-amber-400 shadow"></span>
            <span class="text-[11px] font-medium text-white">原图紫金</span>
          </button>
          <button data-glow="glow-cyan-pink" class="glow-opt-btn p-2 rounded-xl border border-zinc-700 bg-zinc-800/40 flex flex-col items-center gap-1.5 transition">
            <span class="w-5 h-5 rounded-full bg-gradient-to-r from-cyan-400 via-blue-500 to-pink-500 shadow"></span>
            <span class="text-[11px] font-medium text-zinc-400">赛博蓝粉</span>
          </button>
          <button data-glow="glow-aurora-green" class="glow-opt-btn p-2 rounded-xl border border-zinc-700 bg-zinc-800/40 flex flex-col items-center gap-1.5 transition">
            <span class="w-5 h-5 rounded-full bg-gradient-to-r from-emerald-400 via-teal-400 to-indigo-500 shadow"></span>
            <span class="text-[11px] font-medium text-zinc-400">极光葱绿</span>
          </button>
          <button data-glow="glow-sunset-gold" class="glow-opt-btn p-2 rounded-xl border border-zinc-700 bg-zinc-800/40 flex flex-col items-center gap-1.5 transition">
            <span class="w-5 h-5 rounded-full bg-gradient-to-r from-rose-500 via-orange-400 to-amber-300 shadow"></span>
            <span class="text-[11px] font-medium text-zinc-400">落日鎏金</span>
          </button>
          <button data-glow="glow-rainbow-ai" class="glow-opt-btn p-2 rounded-xl border border-zinc-700 bg-zinc-800/40 flex flex-col items-center gap-1.5 transition">
            <span class="w-5 h-5 rounded-full bg-gradient-to-r from-pink-500 via-indigo-500 to-emerald-400 shadow"></span>
            <span class="text-[11px] font-medium text-zinc-400">幻彩AI</span>
          </button>
        </div>
      </div>

      <!-- 原生状态栏配置 -->
      <div class="space-y-3 pt-3 border-t border-zinc-800">
        <label class="text-xs font-semibold text-zinc-300 uppercase tracking-wider block flex items-center justify-between">
          <span><i data-lucide="sliders" class="w-3.5 h-3.5 inline mr-1 text-purple-400"></i> 原生状态栏参数</span>
          <button id="btn-sync-time" class="text-[11px] text-purple-400 hover:text-purple-300 transition flex items-center gap-1 font-normal">
            <i data-lucide="clock" class="w-3 h-3"></i> 同步系统当前时间
          </button>
        </label>

        <div class="grid grid-cols-2 gap-3 items-center">
          <div>
            <label class="text-xs text-zinc-400 block mb-1">显示时间</label>
            <input type="text" id="input-bar-time" value="16:01" 
              class="w-full bg-zinc-950 border border-zinc-700 focus:border-purple-500 rounded-xl px-3 py-2 text-sm text-white font-mono outline-none transition">
          </div>
          <div>
            <div class="flex justify-between items-center mb-1">
              <label class="text-xs text-zinc-400">剩余电量</label>
              <span id="label-battery" class="text-xs font-mono text-emerald-400 font-bold">23%</span>
            </div>
            <input type="range" id="input-bar-battery" min="1" max="100" value="23" 
              class="w-full accent-purple-500 cursor-pointer h-2 bg-zinc-800 rounded-lg">
          </div>
        </div>

        <!-- 状态栏小图标开关 -->
        <div class="grid grid-cols-3 gap-2 text-xs pt-1">
          <label class="flex items-center gap-2 p-2 rounded-lg bg-zinc-950/70 border border-zinc-800 cursor-pointer hover:bg-zinc-800/50 transition">
            <input type="checkbox" id="toggle-opt-vpn" checked class="accent-purple-500 rounded">
            <span class="text-zinc-300">VPN 标识</span>
          </label>
          <label class="flex items-center gap-2 p-2 rounded-lg bg-zinc-950/70 border border-zinc-800 cursor-pointer hover:bg-zinc-800/50 transition">
            <input type="checkbox" id="toggle-opt-5g" checked class="accent-purple-500 rounded">
            <span class="text-zinc-300">双卡 5G</span>
          </label>
          <label class="flex items-center gap-2 p-2 rounded-lg bg-zinc-950/70 border border-zinc-800 cursor-pointer hover:bg-zinc-800/50 transition">
            <input type="checkbox" id="toggle-opt-alarm" checked class="accent-purple-500 rounded">
            <span class="text-zinc-300">闹钟图标</span>
          </label>
        </div>

        <div class="flex items-center justify-between text-xs pt-1 px-1">
          <label class="flex items-center gap-2 cursor-pointer">
            <input type="checkbox" id="toggle-opt-cursor" checked class="accent-purple-500 rounded">
            <span class="text-zinc-300">显示幽蓝输入光标</span>
          </label>
          <label class="flex items-center gap-2 cursor-pointer">
            <input type="checkbox" id="toggle-opt-watermark" checked class="accent-purple-500 rounded">
            <span class="text-zinc-300">原图背景流光虚影</span>
          </label>
        </div>
      </div>

      <!-- 生成与导出功能区 -->
      <div class="pt-4 border-t border-zinc-800 space-y-2.5">
        <button id="btn-export-png" class="w-full py-3.5 px-4 rounded-xl font-bold text-sm text-white bg-gradient-to-r from-pink-500 via-purple-600 to-indigo-600 hover:from-pink-600 hover:via-purple-700 hover:to-indigo-700 shadow-xl shadow-purple-600/30 active:scale-[0.98] transition flex items-center justify-center gap-2">
          <i data-lucide="download" class="w-4 h-4"></i>
          <span>一键生成并保存高清原图 (PNG)</span>
        </button>

        <div class="grid grid-cols-2 gap-2">
          <button id="btn-copy-img" class="py-2.5 px-3 rounded-xl border border-zinc-700 bg-zinc-800/80 hover:bg-zinc-700 text-xs font-semibold text-zinc-200 transition flex items-center justify-center gap-1.5">
            <i data-lucide="copy" class="w-3.5 h-3.5"></i>
            <span>复制图片到剪贴板</span>
          </button>
          <button id="btn-mobile-preview" class="py-2.5 px-3 rounded-xl border border-zinc-700 bg-zinc-800/80 hover:bg-zinc-700 text-xs font-semibold text-zinc-200 transition flex items-center justify-center gap-1.5">
            <i data-lucide="maximize" class="w-3.5 h-3.5"></i>
            <span>手机端长按保存</span>
          </button>
        </div>
      </div>

    </div>

    <!-- 右侧渲染展示舞台 (7列) - 绝对保证标准正向竖屏 -->
    <div class="lg:col-span-7 flex flex-col items-center justify-center order-1 lg:order-2">
      
      <!-- 预览状态提示条 -->
      <div class="w-full max-w-[420px] flex items-center justify-between mb-3 px-2 text-xs text-zinc-400">
        <span class="flex items-center gap-1.5 font-medium">
          <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
          <span>标准正向竖屏（所见即所得）</span>
        </span>
        <span class="text-zinc-500">点击搜索框可直接打字</span>
      </div>

      <!-- 截图捕获主容器 (正向垂直竖屏，绝不倾斜旋转) -->
      <div class="w-full flex items-center justify-center py-2 sm:py-4">
        
        <!-- html2canvas 捕捉的目标容器 -->
        <div id="capture-frame-node" class="transition-all duration-300 flex items-center justify-center bg-transparent">
          
          <!-- 手机实体容器：标准垂直方向 w-[360px] sm:w-[380px] -->
          <div id="phone-chassis" class="w-[360px] sm:w-[380px] bg-black rounded-[42px] phone-realistic-frame p-2.5 border-[4px] border-[#22242a] relative select-none transition-all duration-300 overflow-hidden">
            
            <!-- 顶部微缝金属听筒 -->
            <div id="speaker-slit" class="absolute top-[5px] left-1/2 -translate-x-1/2 w-14 h-1 bg-[#2b2d33] rounded-full z-30 pointer-events-none"></div>

            <!-- 手机内屏纯黑 OLED 显示区 (9:19.5 标准长宽比，标准垂直朝向) -->
            <div id="screen-display-area" class="w-full bg-[#000000] rounded-[34px] overflow-hidden relative min-h-[660px] flex flex-col justify-between">
              
              <!-- 屏幕玻璃防眩光反光层 -->
              <div class="absolute inset-0 screen-glass-glare pointer-events-none z-20"></div>

              <!-- 1. 顶部状态栏 (标准横向平铺，正向手机顶部) -->
              <div class="relative z-10 w-full pt-3 px-5 pb-2 flex items-center justify-between text-white text-[11px] font-sans">
                
                <!-- 状态栏左侧：时间、盾牌、定位、通知 -->
                <div class="flex items-center space-x-1.5">
                  <span id="screen-time-text" class="font-semibold text-xs text-zinc-100 tracking-tight" contenteditable="true" spellcheck="false">16:01</span>
                  
                  <!-- 盾牌安全图标 (还原原图) -->
                  <svg class="w-3 h-3 text-zinc-300 opacity-90" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4zm0 2.18l7 3.12v4.7c0 4.54-3.1 8.78-7 9.87-3.9-1.09-7-5.33-7-9.87V6.3l7-3.12z"/>
                  </svg>

                  <!-- 消息通知纸飞机 (还原原图) -->
                  <svg class="w-3 h-3 text-zinc-300 opacity-80" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M2.01 21L23 12 2.01 3 2 10l15 2-15 2z"/>
                  </svg>

                  <!-- 蓝色支付/安全角标 (还原原图) -->
                  <span class="w-3.5 h-3.5 rounded-[3px] bg-[#1677ff] text-[8px] font-bold flex items-center justify-center text-white scale-90">支</span>
                </div>

                <!-- 居中打孔前置摄像头 (Punch-hole) -->
                <div class="w-3.5 h-3.5 rounded-full bg-[#050608] border border-[#1a1b1f] flex items-center justify-center shadow-inner shrink-0">
                  <div class="w-1.5 h-1.5 rounded-full bg-[#0e1628]/95"></div>
                </div>

